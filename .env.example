# Supabase — ระบบหลังบ้าน /admin
# คัดลอกจาก Supabase Dashboard → Project Settings → API
# ไม่ต้องใช้ service role key — ทุกอย่างวิ่งผ่าน publishable key + RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend — ส่งอีเมลจากฟอร์มติดต่อ / ขอใบเสนอราคา (src/lib/enquiry)
# key แบบ "Sending access" พอ ไม่ต้อง Full access
RESEND_API_KEY=
# ปลายทางของเมลจากฟอร์ม เว้นว่าง = ใช้อีเมลบริษัทที่ตั้งไว้ในหลังบ้าน (site.email)
ENQUIRY_TO_EMAIL=
# ผู้ส่ง ต้องเป็น @blue-rich.com (โดเมนที่ verify กับ Resend แล้ว) เว้นว่าง = website@blue-rich.com
ENQUIRY_FROM_EMAIL=
