{
  "name": "blue-rich-redesign-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--max-http-header-size=65536 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prebuild": "node scripts/build-image-manifest.mts",
    "cms:images": "node scripts/build-image-manifest.mts",
    "cms:seed": "node --env-file=.env.local scripts/cms-seed.mts",
    "cms:seed-sql": "node scripts/cms-seed-sql.mts > supabase/seed.sql",
    "cms:verify": "node --env-file=.env.local scripts/cms-verify.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.115.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
